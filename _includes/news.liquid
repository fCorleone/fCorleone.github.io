<div class="news-list">
  {% assign updates = site.news | sort: 'date' | reverse %}
  {% assign news_limit = updates.size %}
  {% if include.limit %}{% assign news_limit = include.count | default: site.announcements.limit | default: 5 %}{% endif %}
  {% for item in updates limit: news_limit %}
    <article class="news-item{% if item.featured %} news-featured{% endif %}">
      <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%Y.%m.%d' }}</time>
      <div>
        {% if item.featured -%}
          <span class="news-tag">{% include bilingual.liquid en="SPEAKING" zh="演讲入选" %}</span>
        {%- endif %}
        {% if item.inline %}
          {% if item.content_zh %}
            <div data-lang="en" lang="en">{{ item.content | markdownify }}</div>
            <div data-lang="zh" lang="zh-CN">{{ item.content_zh | markdownify }}</div>
          {% else -%}
            {{- item.content -}}
          {%- endif %}
        {% else -%}
          <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
        {%- endif %}
      </div>
    </article>
  {% endfor %}
</div>
