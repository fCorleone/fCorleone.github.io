<header>
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Main navigation"
  >
    <div class="container">
      <a class="navbar-brand nameplate" href="{{ '/' | relative_url }}" aria-label="马福辰 Fuchen Ma — Home">
        <span lang="zh-CN">马福辰</span><span class="nameplate-english" lang="en">Fuchen Ma</span>
      </a>
      <button id="language-toggle" class="language-toggle" type="button" aria-label="切换为中文" title="切换为中文" hidden>
        <span aria-hidden="true">中 / EN</span>
      </button>
      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span><span class="icon-bar middle-bar"></span><span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item">
            <a class="nav-link" href="{{ '/' | relative_url }}#publications">{% include bilingual.liquid en="Research" zh="研究" %}</a>
          </li>
          <li class="nav-item{% if page.permalink == '/publications/' %} active{% endif %}">
            <a class="nav-link" href="{{ '/publications/' | relative_url }}">{% include bilingual.liquid en="Publications" zh="论文" %}</a>
          </li>
          <li class="nav-item{% if page.permalink == '/news/' %} active{% endif %}">
            <a class="nav-link" href="{{ '/news/' | relative_url }}">{% include bilingual.liquid en="News" zh="动态" %}</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="{{ '/' | relative_url }}#about">{% include bilingual.liquid en="About" zh="关于" %}</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
