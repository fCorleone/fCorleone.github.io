        <svg class="scene-fallback" viewBox="0 0 560 400" role="img" aria-label="四足机器人结构示意 / Quadruped robot schematic">
          <g fill="none" stroke="#315766" stroke-width="1"><path d="M40 310 280 190 520 310 280 430Z M100 280 340 400 M160 250 400 370 M220 220 460 340 M100 340 340 220 M160 370 400 250 M220 400 460 280"/></g>
          <g fill="#122e3a" stroke="#85d5df" stroke-width="2"><path d="M180 150 310 108 398 151 267 200Z"/><path d="M180 150 267 200 267 230 180 180Z"/><path d="M267 200 398 151 398 180 267 230Z"/></g>
          <g fill="none" stroke="#74c8d2" stroke-width="8" stroke-linecap="round"><path d="M199 182 185 232 204 287 M264 224 253 274 277 329 M329 169 350 218 337 275 M380 185 399 236 384 290"/></g>
          <g fill="#c7f6f7"><circle cx="285" cy="147" r="9"/><circle cx="376" cy="163" r="4"/></g>
        </svg>
      </div>
      <figcaption class="scene-caption">
        <div class="scene-description" data-description="security" hidden>
          {% include bilingual.liquid en="Attack surfaces. Defensive boundaries." zh="寻找攻击面，验证防御边界。" %}
        </div>
        <div class="scene-description" data-description="data">
          {% include bilingual.liquid en="Sense. Generate. Collect. Select." zh="感知、生成、收集与筛选。" %}
        </div>
        <div class="scene-description" data-description="interop" hidden>
          {% include bilingual.liquid en="Different robots. Shared capabilities." zh="连接不同机器人，协同各自的能力。" %}
        </div>
      </figcaption>
      <div class="scene-controls" hidden>
        <div class="scene-modes" role="group" aria-label="研究方向 / Research directions">
          <button type="button" data-mode="security" aria-pressed="false">{% include bilingual.liquid en="Security" zh="安全" %}</button>
          <button type="button" data-mode="data" aria-pressed="true">{% include bilingual.liquid en="Data" zh="数据" %}</button>
          <button type="button" data-mode="interop" aria-pressed="false">{% include bilingual.liquid en="Interop" zh="互操作" %}</button>
        </div>
        <button id="motion-toggle" type="button" data-paused="false">
          <span class="motion-pause">{% include bilingual.liquid en="Pause" zh="暂停" %}</span
          ><span class="motion-play" hidden>{% include bilingual.liquid en="Play" zh="播放" %}</span>
        </button>
      </div>
    </figure>
  </section>

