---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% case page.title -%}
        {%- when 'publications' -%}
          {%- include bilingual.liquid en="Publications" zh="论文列表" -%}
        {%- when 'news' -%}
          {%- include bilingual.liquid en="News" zh="新闻动态" -%}
        {%- else -%}
          {{- page.title -}}
      {%- endcase %}
    </h1>
    <p class="post-description">
      {% if page.title == 'publications' -%}
        {%- include bilingual.liquid en="Research publications, in reverse chronological order." zh="学术论文，按发表年份倒序排列。" -%}
      {%- else -%}
        {{- page.description -}}
      {%- endif %}
    </p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
